# Frontend values; copy to .env.local. `convex dev` writes the deployment values.
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211

# Set backend-only secrets with `bunx convex env set`, not NEXT_PUBLIC variables:
# SITE_URL=http://localhost:3000
# BETTER_AUTH_SECRET=<generate a random secret of at least 32 characters>
# RESEND_API_KEY=<production email provider key>
# AUTH_EMAIL_FROM=QR POS <accounts@your-verified-domain>
# DEV_EMAIL_CAPTURE_URL=http://127.0.0.1:4010/emails  (local backend only)
